<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddRecipeActivity"
    android:background="#F9F9F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share Your Recipe"
            android:textColor="@color/orange_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe Title"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/recipeTitleEt"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="e.g. Italian Pasta"
            android:inputType="text"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="15dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/recipeCategoryEt"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="e.g. Main Dishes"
            android:inputType="text"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="15dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredients :"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/recipeIngredientsEt"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Tomato, Onion, Garlic..."
            android:inputType="textMultiLine"
            android:gravity="top"
            android:background="@android:drawable/edit_text"
            android:padding="15dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Steps :"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/recipeStepsEt"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Boil water, Add salt, Put pasta"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:background="@android:drawable/edit_text"
            android:padding="15dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube Video URL"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/recipeVideoUrlEt"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="https://youtube.com/..."
            android:inputType="textUri"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="15dp"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/saveRecipeBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Save &amp; Publish"
            android:backgroundTint="@color/orange_primary"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="10dp"/>

    </LinearLayout>


</ScrollView>