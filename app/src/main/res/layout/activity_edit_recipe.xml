<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditRecipeActivity"
    android:background="#F9F9F9"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Your Recipe"
            android:textColor="@color/orange_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe Image"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/editSelectImgBtn"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/editRecipeImgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Recipe Image Preview" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe Title"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/editRecipeTitleEt"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="e.g. Italian Pasta"
            android:inputType="text"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="15dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/editRecipeCategoryEt"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="e.g. Main Dishes"
            android:inputType="text"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="15dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredients :"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/editRecipeIngredientsEt"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Tomato, Onion, Garlic..."
            android:inputType="textMultiLine"
            android:gravity="top"
            android:background="@android:drawable/edit_text"
            android:padding="15dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Steps :"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/editRecipeStepsEt"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Boil water, Add salt, Put pasta..."
            android:inputType="textMultiLine"
            android:gravity="top"
            android:background="@android:drawable/edit_text"
            android:padding="15dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube Video URL"
            android:textColor="#333"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:id="@+id/editRecipeVideoUrlEt"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="https://youtube.com/..."
            android:inputType="textUri"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="15dp"
            android:layout_marginBottom="25dp"/>
        <ProgressBar
            android:id="@+id/editProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="15dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/updateRecipeBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Update Recipe"
            android:backgroundTint="@color/orange_primary"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="10dp"/>

    </LinearLayout>

</ScrollView>